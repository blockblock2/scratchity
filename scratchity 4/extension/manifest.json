{
  "manifest_version": 3,
  "name": "Scratchity",
  "version": "1.8.1",
  "description": "Describe a Scratch project, get the blocks, and add them straight to your project. Powered by Qwen2.5-Coder.",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Scratchity",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://scratch.mit.edu/*",
    "https://scratchity.pages.dev/*"
  ]
}